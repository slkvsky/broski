# Get your key at https://resend.com/ — used server-side only by
# api/send-request.js, never exposed to the browser.
RESEND_API_KEY=

# Optional: a verified sender address once a domain is set up in Resend
# (e.g. "Broski Detailing <noreply@broskidetailing.de>"). Falls back to
# Resend's shared sandbox sender otherwise.
RESEND_FROM_EMAIL=
